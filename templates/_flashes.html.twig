{% set flashes = app.flashes(['success', 'danger']) %}
{% set allMessages = (flashes.success ?? [])|merge(flashes.danger ?? []) %}
{% if allMessages is not empty %}
    <div class="toast-container position-fixed start-50 translate-middle-x p-3" style="top: 100px; z-index: 1080;" data-controller="flash">
        {% for type, messages in flashes %}
            {% for message in messages %}
                <div class="toast align-items-center text-bg-{{ type }} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-{{ type == 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' }} me-2"></i>
                            {{ message }}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}
